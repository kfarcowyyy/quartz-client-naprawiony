{
  "schemaVersion": 1,
  "id": "quartz",
  "version": "${version}",
  "name": "Quartz Client",
  "description": "A lightweight, configurable Quartz HUD and in-game client menu.",
  "authors": ["Quartz Client"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["com.quartz.network.QuartzWardrobeSync"],
    "client": ["com.quartz.client.QuartzModClient"]
  },
  "mixins": [{ "config": "quartz.client.mixins.json", "environment": "client" }],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}

